flows:
  - id: success
    name: Consumer build
    tasks:
      - id: python
        type: run-python
        name: Bundled Python
        properties:
          run-inline-python-script: "true"
          inline-python-script: "print('bundled-worker-ok')"
      - id: conditional
        type: if
        name: Bundled Python condition
        properties:
          condition: "1 + 1 == 2"
        children:
          - id: echo
            name: Selected condition
            type: run-command
            properties:
              command: echo bundled-condition-ok
  - id: failure
    name: Deliberate failed consumer build
    tasks:
      - id: fail
        name: Deliberate failure
        type: run-command
        properties:
          command: exit 7
